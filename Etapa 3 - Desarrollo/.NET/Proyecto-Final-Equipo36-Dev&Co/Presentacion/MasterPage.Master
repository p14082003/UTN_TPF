<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MasterPage.Master.cs" Inherits="Presentacion.Site1" %>

<!DOCTYPE html>

<html lang="es" data-bs-theme="light">
<head runat="server">

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>InstiRed</title>
    <!-- LIBRERÍAS BOOTSTRAP -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&display=swap" rel="stylesheet" />
    <link href="~/EstilosInstiRed.css" rel="stylesheet" runat="server" />
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

</head>

<body>

    <a class="visually-hidden-focusable" href="#contenido">Saltar al contenido</a>

    <form id="form1" runat="server">

        <div class="app-shell d-flex flex-column bg-fondo vh-100">
            <!-- Navbar -->
            <nav class="navegacion-principal bg-white d-flex align-items-center justify-content-between flex-wrap gap-2 pe-3" aria-label="Navegación principal">
                <a href="ListadoInstituciones.aspx" class="marca-instired d-flex align-items-center text-decoration-none" aria-label="Ir al listado de instituciones">
                    <img src="Imagenes/Logo.png" alt="InstiRed" height="60" />
                </a>

                <button id="botonMenu" type="button" class="boton-menu" aria-expanded="false" aria-controls="accesosNavegacion" aria-label="Abrir menú de navegación">
                    <svg class="icono-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                    <svg class="icono-cerrar" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                </button>

                <div id="accesosNavegacion" class="accesos-principales d-flex align-items-center flex-wrap gap-2 me-auto ms-3">
                    <asp:Panel ID="pnlMenuResponsable" runat="server" Visible="false" CssClass="d-flex align-items-center flex-wrap gap-2">
                        <asp:HyperLink ID="lnkRegistrarAlumno" runat="server" NavigateUrl="~/RegistroAlumno.aspx"
                            CssClass="btn btn-sm btn-lilaClaro px-3 py-2" Text="Registrar alumno" Visible="false" />
                        <asp:HyperLink ID="lnkMisPostulaciones" runat="server" NavigateUrl="~/ListadoPostulacionAlumnos.aspx"
                            CssClass="btn btn-sm btn-lilaClaro px-3 py-2" Text="Mis postulaciones" />
                    </asp:Panel>

                    <!-- Acceso de Dev&Co -->
                    <asp:HyperLink ID="lnkPanelDevCo" runat="server" NavigateUrl="~/AdminDevCo.aspx"
                        CssClass="btn btn-sm btn-lilaClaro px-3 py-2" Text="Panel de control" Visible="false" />

                    <!-- Menú del administrador de institución -->
                    <asp:Panel ID="pnlMenuAdmin" runat="server" Visible="false" CssClass="d-flex align-items-center flex-wrap gap-2">
                        <asp:HyperLink ID="lnkMiInstitucion" runat="server" NavigateUrl="~/FormularioInstitucion.aspx"
                            CssClass="btn btn-sm btn-lilaClaro px-3 py-2" Text="Mi institución" Visible="false" />
                        <asp:HyperLink ID="lnkPostulaciones" runat="server" NavigateUrl="~/GestionarPostulacionAlumno.aspx" CssClass="btn btn-sm btn-lilaClaro px-3 py-2" Text="Postulaciones" />
                        <asp:HyperLink ID="lnkAgregarAdministrador" runat="server" NavigateUrl="~/FormularioAdministradorAdicional.aspx"
                            CssClass="btn btn-sm btn-lilaClaro px-3 py-2" Text="Agregar administrador" Visible="false" />
                        <asp:HyperLink ID="lnkAdministradores" runat="server" NavigateUrl="~/GestionarAdministradores.aspx" CssClass="btn btn-sm btn-lilaClaro px-3 py-2" Text="Administradores" />
                        <asp:HyperLink ID="lnkVacantes" runat="server" NavigateUrl="~/GestionarVacante.aspx" CssClass="btn btn-sm btn-lilaClaro px-3 py-2" Text="Cursos y vacantes" />
                        <asp:HyperLink ID="lnkResenias" runat="server" NavigateUrl="~/GestionarResenia.aspx" CssClass="btn btn-sm btn-lilaClaro px-3 py-2" Text="Reseñas" />
                    </asp:Panel>
                </div>

                <asp:HyperLink ID="lnkIniciarSesion" runat="server" NavigateUrl="~/Login.aspx"
                    CssClass="entrada-sesion btn btn-lilaClaro px-3 py-2" Text="Iniciar sesión" />
                <asp:Panel ID="pnlSesion" runat="server" Visible="false" CssClass="menu-cuenta position-relative">
                    <details>
                        <summary class="btn btn-sm btn-lilaClaro px-3 py-2 d-flex align-items-center gap-2">
                            <i class="bi bi-person-circle fs-4" aria-hidden="true"></i>
                            <span class="nombre-usuario"><asp:Literal ID="litSaludo" runat="server" Mode="Encode" /></span>
                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                        </summary>
                        <div class="card position-absolute end-0 mt-1 shadow z-3 text-nowrap">
                            <div class="d-grid gap-1 p-1">
                                <asp:HyperLink ID="lnkMiPerfil" runat="server" NavigateUrl="~/MiPerfil.aspx" CssClass="btn btn-sm btn-lilaClaro justify-content-start px-2 py-2">
                                    <i class="bi bi-person me-2" aria-hidden="true"></i><span>Mi perfil</span>
                                </asp:HyperLink>
                                <asp:LinkButton ID="btnCerrarSesion" runat="server" CssClass="btn btn-sm btn-lilaClaro justify-content-start px-2 py-2" CausesValidation="false" OnClick="btnCerrarSesion_Click">
                                    <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i><span>Cerrar sesión</span>
                                </asp:LinkButton>
                            </div>
                        </div>
                    </details>
                </asp:Panel>

            </nav>

            <!-- Formularios -->
            <main id="contenido" class="container flex-grow-1 position-relative overflow-auto" style="max-width: 1320px; min-height: 0;">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
            </main>

            <!-- Confirmación de acciones: lo usan los botones con OnClientClick="return confirmarAccion(this, 'mensaje', 'texto del botón');" -->
            <dialog class="dialog" id="dlgConfirmarAccion">
                <div class="dialog-header">
                    <h5 class="dialog-title text-indigo">Confirmar</h5>
                </div>
                <div class="dialog-body">
                    <p id="textoConfirmarAccion"></p>
                </div>
                <div class="dialog-footer">
                    <button type="button" class="btn btn-lilaClaro" onclick="document.getElementById('dlgConfirmarAccion').close()">Cancelar</button>
                    <button type="button" id="btnConfirmarAccion" class="btn-lilaOscuro">Confirmar</button>
                </div>
            </dialog>

            <!-- Footer -->
            <footer class="bg-indigo text-center">
                <small>© 2026 InstiRed. Todos los derechos reservados.</small>
            </footer>

        </div>
    </form>

    <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL" crossorigin="anonymous"></script>
    <script>
        (function () {
            var boton = document.getElementById('botonMenu');
            var navegacion = boton.closest('nav');

            function cambiarMenu(abierto) {
                navegacion.classList.toggle('menu-abierto', abierto);
                boton.setAttribute('aria-expanded', abierto ? 'true' : 'false');
                boton.setAttribute('aria-label', abierto ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
                if (abierto) {
                    var cuenta = navegacion.querySelector('.menu-cuenta details');
                    if (cuenta) cuenta.open = false;
                }
            }

            boton.addEventListener('click', function () {
                cambiarMenu(boton.getAttribute('aria-expanded') !== 'true');
            });
            document.addEventListener('click', function (event) {
                if (!navegacion.contains(event.target) || event.target.closest('.accesos-principales a, .menu-cuenta summary')) {
                    cambiarMenu(false);
                }
            });
            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape' && boton.getAttribute('aria-expanded') === 'true') {
                    cambiarMenu(false);
                    boton.focus();
                }
            });
            window.matchMedia('(max-width: 767px)').addEventListener('change', function () { cambiarMenu(false); });
        })();
    </script>
    <script>
        // CONFIRMAR ACCIÓN: el botón llama a esta función y no hace postback (devuelve false).
        // Si el usuario acepta, se vuelve a hacer clic en ese mismo botón sin el onclick, y ahí sí se envía.
        var botonConfirmar = null;
        function confirmarAccion(boton, mensaje, textoBoton) {
            botonConfirmar = boton;
            document.getElementById('textoConfirmarAccion').textContent = mensaje;
            document.getElementById('btnConfirmarAccion').textContent = textoBoton || 'Confirmar';
            document.getElementById('dlgConfirmarAccion').showModal();
            return false;
        }
        document.getElementById('btnConfirmarAccion').addEventListener('click', function () {
            document.getElementById('dlgConfirmarAccion').close();
            botonConfirmar.onclick = null;
            botonConfirmar.click();
        });
    </script>

</body>

</html>
