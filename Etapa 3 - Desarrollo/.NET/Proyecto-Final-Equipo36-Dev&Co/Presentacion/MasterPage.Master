<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MasterPage.Master.cs" Inherits="Presentacion.Site1" %>

<!DOCTYPE html>

<html data-bs-theme="light">
<head runat="server">

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>InstiRed</title>
    <!-- LIBRERÍAS BOOTSTRAP -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&display=swap" rel="stylesheet" />
    <link href="~/EstilosInstiRed.css" rel="stylesheet" runat="server" />
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

</head>

<body>

    <a class="visually-hidden-focusable" href="#contenido">Saltar al contenido</a>

    <form id="form1" runat="server">

        <div class="d-flex flex-column bg-fondo vh-100">
            <!-- Navbar -->
            <nav class="bg-white d-flex align-items-center justify-content-between flex-wrap gap-2 pe-3">
                <a href="Login.aspx" class="d-flex align-items-center text-decoration-none">
                    <img src="Imagenes/Logo.png" alt="InstiRed" height="60" />
                </a>

                <!-- Menú del administrador de institución -->
                <asp:Panel ID="pnlMenuAdmin" runat="server" Visible="false" CssClass="d-flex align-items-center flex-wrap gap-2 me-auto ms-3">
                    <asp:HyperLink ID="lnkPostulaciones" runat="server" NavigateUrl="~/GestionarPostulacionAlumno.aspx" CssClass="btn btn-sm btn-lilaClaro px-3 py-2" Text="Postulaciones" />
                    <asp:HyperLink ID="lnkAdministradores" runat="server" NavigateUrl="~/GestionarAdministradores.aspx" CssClass="btn btn-sm btn-lilaClaro px-3 py-2" Text="Administradores" />
                    <asp:HyperLink ID="lnkVacantes" runat="server" NavigateUrl="~/GestionarVacante.aspx" CssClass="btn btn-sm btn-lilaClaro px-3 py-2" Text="Cursos y vacantes" />
                </asp:Panel>

                <asp:HyperLink ID="lnkIniciarSesion" runat="server" NavigateUrl="~/Login.aspx"
                    CssClass="btn btn-lilaClaro px-3 py-2" Text="Iniciar sesión" />
                <asp:Panel ID="pnlSesion" runat="server" Visible="false" CssClass="position-relative">
                    <details>
                        <summary class="btn btn-sm btn-lilaClaro px-3 py-2 d-flex align-items-center gap-2">
                            <i class="bi bi-person-circle fs-4" aria-hidden="true"></i>
                            <asp:Literal ID="litSaludo" runat="server" Mode="Encode" />
                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                        </summary>
                        <div class="card position-absolute end-0 mt-1 shadow z-3 text-nowrap">
                            <div class="d-grid gap-1 p-1">
                                <asp:HyperLink ID="lnkMiPerfil" runat="server" NavigateUrl="~/MiPerfil.aspx" CssClass="btn btn-sm btn-lilaClaro justify-content-start px-2 py-1">
                                    <i class="bi bi-person me-1" aria-hidden="true"></i><span class="small">Mi perfil</span>
                                </asp:HyperLink>
                                <asp:LinkButton ID="btnCerrarSesion" runat="server" CssClass="btn btn-sm btn-lilaClaro justify-content-start px-2 py-1" CausesValidation="false" OnClick="btnCerrarSesion_Click">
                                    <i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i><span class="small">Cerrar sesión</span>
                                </asp:LinkButton>
                            </div>
                        </div>
                    </details>
                </asp:Panel>

            </nav>

            <!-- Formularios -->
            <main id="contenido" class="container flex-grow-1 position-relative overflow-auto" style="max-width: 1320px; min-height: 0;">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
            </main>

            <!-- Footer -->
            <footer class="bg-indigo text-center">
                <small>© 2026 InstiRed. Todos los derechos reservados.</small>
            </footer>

        </div>
    </form>

    <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL" crossorigin="anonymous"></script>

</body>

</html>
