<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="Presentacion.SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>InstiRed</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    
    <style>
        body {
            margin: 0;
            background-color: #f6f7fc;
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>

    <body>
        <form id="form1" runat="server">
            <div class="d-flex flex-column min-vh-100">

                <nav class="navbar bg-white border-bottom px-3 px-md-4 py-2">
                    <div class="container-fluid p-0 d-flex justify-content-between align-items-center">

                        <a href="Login.aspx" class="d-flex align-items-center text-decoration-none">
                            <img src="Imagenes/LogoNavBar.png"
                                 alt="InstiRed"
                                 height="60" />
                        </a>
                        <span class="text-secondary small">Red educativa</span>
                    </div>
                </nav>

                <main class="flex-grow-1">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                </main>


                <footer class="text-white p-3" style="background-color: #373a78;">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                        <strong class="fs-5">InstiRed</strong>

                        <div class="small">
                            <a href="#" class="text-white text-decoration-none">Ayuda</a>
                            ·
                            <a href="#" class="text-white text-decoration-none">Contacto</a>
                            ·
                            <a href="#" class="text-white text-decoration-none">Privacidad</a>
                        </div>
                    </div>

                    <small>© 2026 InstiRed. Todos los derechos reservados.</small>
                </footer>
            </div>
        </form>
    </body>
</html>